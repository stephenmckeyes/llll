# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Required for applying DB migrations (`npm run db:apply`) — not used at runtime.
# Find under: Supabase dashboard → Project Settings → Database → Connection string.
# Copy the URI EXACTLY as shown (the username must match the host: a
# "...pooler.supabase.com" host uses user "postgres.<project-ref>"; the direct
# "db.<ref>.supabase.co" host uses just "postgres"). Example shapes:
#   Direct:          postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   Session pooler:  postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# If your DB password has symbols (@ : / # ? & …), DON'T wrestle with encoding
# them inside the URL — leave the [PASSWORD] placeholder in DATABASE_URL and put
# the raw password here instead (quote it). The migrate script injects it safely.
# DATABASE_PASSWORD="your-raw-password"
